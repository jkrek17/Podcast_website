---
import type { Episode } from '../lib/feed';
import { url } from '../lib/url';
interface Props { episode: Episode; label?: string }
const { episode, label = 'Play episode' } = Astro.props;
---
{episode.audioUrl && (
  <>
    <button
      type="button"
      class="btn btn-primary play-btn"
      data-play
      data-src={episode.audioUrl}
      data-title={episode.title}
      data-href={url(`/episodes/${episode.slug}/`)}
    >
      <span class="when-paused">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M7 4.5v15l13-7.5z" /></svg>
        {label}
      </span>
      <span class="when-playing">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M6 4.5h4.5v15H6zm7.5 0H18v15h-4.5z" /></svg>
        Pause
      </span>
    </button>
    <noscript>
      <audio controls preload="none" src={episode.audioUrl} aria-label={`Play ${episode.title}`}></audio>
    </noscript>
  </>
)}
