---
import type { Episode } from '../lib/feed';
interface Props { episode: Episode }
const { episode } = Astro.props;
---
{episode.audioUrl && (
  <audio controls preload="none" aria-label={`Play ${episode.title}`}>
    <source src={episode.audioUrl} type={episode.audioType ?? undefined} />
    <a href={episode.audioUrl}>Download the audio</a>
  </audio>
)}
