---
import Base from '../../layouts/Base.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { getEpisodes } from '../../lib/feed';
const episodes = await getEpisodes();
---
<Base title="Episodes" description="Every episode of the show, newest first.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Archive</p>
      <h1>Episodes</h1>
      <p class="lede">All {episodes.length} episodes, newest first.</p>
    </header>
    <ul class="grid">
      {episodes.map((e) => <li><EpisodeCard episode={e} /></li>)}
    </ul>
  </div>
</Base>
